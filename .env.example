# Copy to .env if you want to override defaults.
# All variables below have sensible defaults for docker compose — no changes needed for local testing.

# Path where SQLite database is stored (inside the backend container)
DATABASE_URL=/data/sqlite/db.sqlite

# BuildKit daemon address (docker-compose service name)
BUILDKIT_HOST=docker-container://buildkit

# Caddy admin API URL (reachable from the backend container)
CADDY_ADMIN_URL=http://caddy:2019

# Docker network name — deployed containers join this network so Caddy can reach them
DOCKER_NETWORK=brimble_net

# Directory where source workspaces are checked out (inside the backend container)
WORKSPACES_DIR=/volumes/workspaces

# Backend API port
PORT=3001
